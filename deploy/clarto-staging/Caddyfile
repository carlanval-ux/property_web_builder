# CLARTO staging reverse proxy.
# Certificates: Let's Encrypt with automatic renewal (TLS_MODE unset or "acme").
# TLS_MODE=internal switches to Caddy's local CA (CI, or a host without public DNS).

(tls-acme) {
}

(tls-internal) {
	tls internal
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		-X-Powered-By
		-X-Runtime
		-X-Request-Id
	}
}

# Catalog indexing. CATALOG_INDEXING=off (default) while fictitious listings
# exist: noindex header on every response and a robots.txt that disallows all.
# Switch with scripts/catalog-indexing.sh, which refuses while test listings remain.
(indexing-off) {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}
}

(indexing-on) {
}

# ---------------------------------------------------------------------------
# Panel (CLARTO Gestión Inmobiliaria): internal tool. Every page requires a
# session (APP_STAFF_ONLY in the app); photos and uploads under /storage are
# served by Apache, so they are checked against the same session here.
# ---------------------------------------------------------------------------
{$LIBERU_HOST} {
	import tls-{$TLS_MODE:acme}
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	request_body {
		max_size 64MB
	}

	# Public self-registration does not exist on the panel.
	@register path /register /register/* /admin/register* /app/register* /api/v1/auth/register
	respond @register 404

	# Test mailbox (Mailpit): every mail both apps send in staging lands here.
	handle /buzon* {
		import /etc/caddy/panel_auth.caddy
		reverse_proxy mailpit:8025
	}

	handle /storage/* {
		forward_auth liberu-app:80 {
			uri /_auth/check
		}
		reverse_proxy liberu-app:80
	}

	handle {
		reverse_proxy liberu-app:80
	}
}

# ---------------------------------------------------------------------------
# Website preview (branch under review): open without password, never indexed.
# ---------------------------------------------------------------------------
{$PREVIEW_HOST} {
	import tls-{$TLS_MODE:acme}
	import security_headers
	import indexing-off
	encode zstd gzip
	reverse_proxy web-preview:3000
}

